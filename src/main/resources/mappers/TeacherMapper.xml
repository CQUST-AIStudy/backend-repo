<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tap.backend.academic.dao.TeacherDao">
    <!-- 查询结果映射 -->
    <resultMap id="teacherResultMap" type="com.tap.backend.academic.entity.teacher.Teacher">
        <id property="teacher_id" column="teacher_id"/>
        <result property="teacher_name" column="teacher_name"/>
        <result property="username" column="username"/>
        <result property="classroom" column="classroom"/>
    </resultMap>
    
    <!-- 根据用户名查询老师信息（查 tap_user 表） -->
    <select id="findByUsername" parameterType="string" resultMap="teacherResultMap">
        SELECT 
            id AS teacher_id,
            username,
            display_name AS teacher_name,
            classname AS classroom
        FROM tap_user 
        WHERE username = #{username} AND role = 'TEACHER'
    </select>
    
    <!-- 根据用户名获取老师ID（查 tap_user 表） -->
    <select id="findTeacherIdByUsername" parameterType="string" resultType="int">
        SELECT id FROM tap_user WHERE username = #{username} AND role = 'TEACHER'
    </select>
    
    <!-- 根据老师ID查询老师信息（查 tap_user 表） -->
    <select id="findByTeacherId" parameterType="int" resultMap="teacherResultMap">
        SELECT 
            id AS teacher_id,
            username,
            display_name AS teacher_name,
            classname AS classroom
        FROM tap_user 
        WHERE id = #{teacherId} AND role = 'TEACHER'
    </select>
</mapper>
