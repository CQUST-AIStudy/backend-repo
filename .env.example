# Copy this file to `.env` on the server and replace placeholders.

# Container
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
JAVA_OPTS=-Xms512m -Xmx1024m

# MySQL on the same server host by default.
# For a service in the same Docker network, use its compose service name instead.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=ptadatabase
DB_USERNAME=root
DB_PASSWORD=replace-me
DB_POOL_MAX=30
DB_POOL_MIN=10

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=http://host.docker.internal:19000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=tap-files

# Security
JWT_ISSUER=tap
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_TTL_SECONDS=3600
# Leave empty to reuse JWT_SECRET.
PTA_CREDENTIALS_SECRET=

# AI providers
AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-vl-max-latest
DEEPL_API_KEY=
VOLCANO_API_KEY=
ARK_API_KEY=

# Services on the same server host by default.
# If they are in the same compose network, switch to URLs such as http://rag-service:8001.
RAG_SERVICE_BASE_URL=http://host.docker.internal:8001
PTA_SPIDER_URL=http://host.docker.internal:8100
PTA_SPIDER_AUTO_START=false
RECOMMENDATION_SERVICE_BASE_URL=http://host.docker.internal:8003
TAP_ERROR_ANALYSIS_BASE_URL=http://host.docker.internal:8002

# CORS
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://host.docker.internal:*
